# Copy to .env (never commit the real file).

# Server
PORT=3000
# Long random string. Keeps devices paired across server restarts.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SECRET=
# How long shared items live (hours)
ITEM_TTL_HOURS=24
# Storage caps (in RAM)
MAX_ROOM_MB=200
MAX_STORE_MB=512
# Which websites may call the API. "*" = any (safe here: auth uses tokens, not cookies).
# Example: https://yourname.github.io
ALLOWED_ORIGINS=*

# Frontend (only when the page is hosted separately, e.g. GitHub Pages)
# VITE_SERVER_URL=https://qrlinkshare.onrender.com

# This site's public address(es), comma-separated. Wallet sign-in messages name only
# these sites. On Render this is detected automatically.
# PUBLIC_ORIGIN=https://share.example.com
# Per-IP upload allowance
UPLOAD_MB_PER_HOUR=300
