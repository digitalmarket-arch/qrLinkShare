# qrLinkShare is a static site: no server, no secrets. These optional build-time
# settings are only for testing or self-hosting. Leave them unset normally.

# Use your own Nostr relays to find devices (comma-separated wss:// URLs).
# Default: Trystero's public relays.
# VITE_RELAY_URLS=wss://relay.example.com

# STUN servers: each device asks one for its own internet address so devices on
# different networks can reach each other (they see the IP address only, never content).
# Default: stun:stun.cloudflare.com:3478. Comma-separated; "" = none (same Wi-Fi only).
# VITE_ICE_SERVERS=stun:stun.cloudflare.com:3478

# Optional TURN relay for very strict networks (corporate firewalls, some mobile data).
# Note: a TURN server relays the (still encrypted) traffic when a direct link is impossible.
# VITE_TURN_URLS=turns:turn.example.com:443
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
