{
  "name": "qrLinkShare",
  "short_name": "qrLinkShare",
  "description": "Send links, photos, documents and notes between your phone and computer, directly. Nothing stored on any server.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5f5f1",
  "theme_color": "#4f3ff0",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "share-title", "text": "share-text", "url": "share-url" }
  }
}
